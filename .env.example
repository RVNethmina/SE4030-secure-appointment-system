# ---------------------------------------------------------------------------
# Docker Compose variables. Copy to `.env` (git-ignored) and set real values.
# API secrets live in backend/.env (see backend/.env.example).
# ---------------------------------------------------------------------------

# Credentials for the MongoDB container. Use letters and digits only: they are
# placed inside the connection URI. Generate a password with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
MONGO_ROOT_USERNAME=prescripto
MONGO_ROOT_PASSWORD=change-me-to-a-random-hex-string

# Host ports for the two web apps (stop the Vite dev servers first if they use them)
FRONTEND_PORT=5173
ADMIN_PORT=5174

# Public Google OAuth client id, baked into the patient app at build time.
# Add http://localhost:5173 to the client's Authorized JavaScript origins.
VITE_GOOGLE_CLIENT_ID=
