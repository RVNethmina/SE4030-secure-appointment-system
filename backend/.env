# environment variable
# NOTE (security assignment): The ORIGINAL upstream repository committed this
# file with LIVE MongoDB Atlas, Cloudinary and Razorpay credentials. For our
# hardened repository we have REDACTED those live external credentials, but we
# intentionally preserve the *weak* values (JWT_SECRET='RBRO',
# ADMIN_PASSWORD='qwerty123') so the vulnerability is faithfully reproducible.
# This entire file is removed from version control in the very next commit.
MONGODB_URI = 'mongodb+srv://<REDACTED_USER>:<REDACTED_PASS>@cluster0.example.mongodb.net'
CLOUDINARY_NAME = '<REDACTED>'
CLOUDINART_API_KEY = '<REDACTED>'
CLOUDINARY_SECRET_KEY = '<REDACTED>'
ADMIN_EMAIL = 'admin@prescripto.com'
ADMIN_PASSWORD = 'qwerty123'
JWT_SECRET = 'RBRO'
RAZORPAY_KEY_ID = '<REDACTED>'
RAZORPAY_KEY_SECRET = ''
CURRENCY = 'LKR'
