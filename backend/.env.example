# ---------------------------------------------------------------------------
# Backend environment template. Copy to `.env` and fill with REAL values.
# NEVER commit the real .env file (it is git-ignored).
# ---------------------------------------------------------------------------

# MongoDB Atlas connection string (rotate the credentials that were leaked in git history)
MONGODB_URI='mongodb+srv://<user>:<password>@<cluster>.mongodb.net'

# Cloudinary media storage
CLOUDINARY_NAME='<your_cloud_name>'
CLOUDINARY_API_KEY='<your_api_key>'
CLOUDINARY_SECRET_KEY='<your_api_secret>'

# Admin account (bootstrap). The server refuses to start unless the password is
# at least 12 chars with upper/lower-case letters, a number and a symbol.
ADMIN_EMAIL='admin@example.com'
ADMIN_PASSWORD='<use-a-long-random-password-min-12-chars>'

# JWT signing secret. MUST be >= 32 random chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET='<generate-a-long-random-secret>'
# Access-token lifetime (e.g. 1h, 15m, 7d)
JWT_EXPIRES_IN='1d'

# Razorpay payment gateway (test keys)
RAZORPAY_KEY_ID='<your_key_id>'
RAZORPAY_KEY_SECRET='<your_key_secret>'
CURRENCY='LKR'

# Server
PORT=4000
# Comma-separated list of allowed browser origins (frontend + admin panel)
ALLOWED_ORIGINS='http://localhost:5173,http://localhost:5174'
# Number of reverse-proxy hops to trust for X-Forwarded-For. Leave unset when
# the API is exposed directly, otherwise clients can spoof their IP and bypass
# rate limiting. Example behind one load balancer: TRUST_PROXY=1
# TRUST_PROXY=1

# Google OAuth 2.0 / OpenID Connect (for "Sign in with Google")
GOOGLE_CLIENT_ID='<your-google-oauth-client-id>.apps.googleusercontent.com'
